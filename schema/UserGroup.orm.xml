<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\UserGroup" table="user_groups">
        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Oryx\ORM\SodiumUuidGenerator"/>
        </id>
        
        <unique-constraints>
            <unique-constraint name="user_group_unique" columns="user_id,group_id"/>
        </unique-constraints>
        
        <many-to-one target-entity="App\Entity\User" field="user" inversed-by="userGroups">
            <join-column name="user_id" nullable="false"/>
        </many-to-one>
        
        <many-to-one target-entity="App\Entity\Group" field="group" inversed-by="userGroups">
            <join-column name="group_id" nullable="false"/>
        </many-to-one>
        
        <field name="grantedAt" type="datetime_immutable"/>
        <field name="expiresAt" type="datetime_immutable" nullable="true"/>
    </entity>
</doctrine-mapping>
