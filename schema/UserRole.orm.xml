<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\UserRole" table="user_roles">
        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Oryx\ORM\SodiumUuidGenerator"/>
        </id>
        <field name="grantedAt" type="datetime_immutable"/>
        <field name="expiresAt" type="datetime_immutable" nullable="true"/>
        
        <unique-constraints>
            <unique-constraint name="user_role_unique" columns="user_id,role_id"/>
        </unique-constraints>
        
        <many-to-one target-entity="App\Entity\User" field="user" inversed-by="userRoles">
            <join-column name="user_id" nullable="false"/>
        </many-to-one>
        
        <many-to-one target-entity="App\Entity\Role" field="role" inversed-by="userRoles">
            <join-column name="role_id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
