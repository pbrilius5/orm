<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\Patronus" table="patronuses">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="token" type="string" length="64" unique="true"/>
        <field name="issuedAt" type="datetime"/>
        <field name="expiresAt" type="datetime"/>
        
        <many-to-one target-entity="App\Entity\User" field="user" inversed-by="patronuses">
            <join-column name="user_id" nullable="false"/>
        </many-to-one>
        
        <many-to-one target-entity="App\Entity\Role" field="role" inversed-by="patronuses">
            <join-column name="role_id" nullable="true"/>
        </many-to-one>
        
        <many-to-one target-entity="App\Entity\Team" field="team">
            <join-column name="team_id" nullable="true"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
