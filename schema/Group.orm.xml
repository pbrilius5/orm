<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\Group" table="groups" inheritance-type="SINGLE_TABLE">
        <id name="id" type="uuid" column="id">
            <generator strategy="CUSTOM"/>
            <custom-id-generator class="Oryx\ORM\SodiumUuidGenerator"/>
        </id>
        <field name="name" type="string" length="255"/>
        <field name="description" type="string" nullable="true"/>
        <field name="createdAt" type="datetime_immutable"/>
        
        <discriminator-column name="discr" type="string"/>
        <discriminator-map>
            <discriminator-mapping value="group" class="App\Entity\Group"/>
            <discriminator-mapping value="developer" class="App\Entity\DeveloperGroup"/>
            <discriminator-mapping value="designer" class="App\Entity\DesignerGroup"/>
            <discriminator-mapping value="tester" class="App\Entity\TesterGroup"/>
        </discriminator-map>
        
        <one-to-many target-entity="App\Entity\UserGroup" field="userGroups" mapped-by="group" orphan-removal="true" cascade="persist"/>
    </entity>
</doctrine-mapping>
