<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="https://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="https://doctrine-project.org/schemas/orm/doctrine-mapping
                                      https://doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Entity\InvisibilityCloak" table="invisibility_cloaks">
        <id name="id" type="integer">
            <generator strategy="AUTO"/>
        </id>
        <field name="grantedAt" type="datetime"/>
        <field name="expiresAt" type="datetime" nullable="true"/>
        <field name="isActive" type="boolean"/>
        
        <many-to-one target-entity="App\Entity\User" field="user" inversed-by="invisibilityCloaks">
            <join-column name="user_id" nullable="false"/>
        </many-to-one>
        
        <many-to-one target-entity="App\Entity\Team" field="team" inversed-by="invisibilityCloaks">
            <join-column name="team_id" nullable="false"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
