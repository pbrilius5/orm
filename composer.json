{
  "name": "oryx/orm",
  "description": "DQL-centric ORM for PHP 8.0+ with Symfony-inspired scout querying & oryx/mvc-adr integration",
  "type": "library",
  "license": "BSD-3-Clause",
  "require": {
    "php": "^8.2",
    "doctrine/dbal": "^3.0",
    "doctrine/orm": "^2.14",
    "doctrine/migrations": "^3.5",
    "fakerphp/faker": "^1.23",
    "doctrine/annotations": "^2.0",
    "league/config": "^1.2",
    "league/event": "^2.2",
    "league/factory-muffin": "^3.0",
    "league/flysystem": "^3.0",
    "league/fractal": "^0.21",
    "league/pipeline": "^1.0",
    "league/tactician": "^2.0",
    "league/uri": "^6.0",
    "symfony/dotenv": "^6.4",
    "league/climate": "^3.10",
    "doctrine/instantiator": "^1.5",
    "nette/utils": "^4.0",
    "symfony/console": "^6.0",
    "symfony/string": "^6.0",
    "symfony/event-dispatcher": "^6.0",
    "symfony/filesystem": "^6.0",
    "symfony/finder": "^6.0",
    "symfony/options-resolver": "^6.0",
    "symfony/process": "^6.0",
    "symfony/stopwatch": "^6.0",
    "webmozart/assert": "^1.0",
    "oryx/mvc": "dev-develop",
    "oryx/adr": "dev-develop",
    "symfony/yaml": "^6.4",
    "laminas/laminas-form": "^2.6",
    "laminas/laminas-inputfilter": "^2.5",
    "laminas/laminas-validator": "^2.5",
    "laminas/laminas-hydrator": "^1.0",
    "laminas/laminas-servicemanager": "^2.6",
    "laminas/laminas-filter": "^2.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5",
    "mockery/mockery": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.0",
    "phpstan/phpstan": "^0.12"
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "https://gitlab.com/umidigi-ss/mvc.git"
    },
    {
      "type": "vcs",
      "url": "https://gitlab.com/umidigi-ss/adr.git"
    },
    {
      "type": "composer",
      "url": "https://repo.packagist.org",
      "canonical": false
    }
  ],
    "autoload": {
        "psr-4": {
            "Oryx\\ORM\\": "src/Oryx/ORM/",
            "App\\": "src/"
        }
    },
  "autoload-dev": {
    "psr-4": {
      "Oryx\\ORM\\Tests\\": "tests/",
      "App\\Tests\\": "tests/"
    }
  },
  "bin": [
    "bin/console"
  ],
  "scripts": {
    "cs-check": "php-cs-fixer fix --dry-run --diff --allow-unsupported-php-version=no",
    "cs-fix": "php-cs-fixer fix --allow-unsupported-php-version=no",
    "serve": [
	"Composer\\Config::disableProcessTimeout",
	"php -S localhost:8080 -t public"
    ],
    "stan": "phpstan analyse src tests",
    "test": "phpunit"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
