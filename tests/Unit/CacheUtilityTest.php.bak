    public function testGetKeysReturnsEmptyWhenDisabled(): void
    {
        $mockEm = $this->createMock(\Oryx\ORM\EntityManager::class);
        $mockEm->method('getMetadataCache')->willReturn(null);

        $utility = new CacheUtility($mockEm);
