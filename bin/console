#!/usr/bin/env php
<?php
declare(strict_types=1);

use Symfony\Component\Console\Application;

require_once __DIR__ . '/../vendor/autoload.php';

$application = new Application();
$application->setName('Oryx ORM Console');
$application->setVersion('1.0.0');

$application->add(new App\Console\Command\GenerateEntitiesCommand());
$application->add(new App\Console\Command\FixturesLoadCommand());
$application->add(new App\Console\Command\DatabaseCreateCommand());
$application->add(new App\Console\Command\ProxyClearCommand());
$application->add(new App\Console\Command\ProxyGenerateCommand());

$application->run();
