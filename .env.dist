# Oryx ORM Environment Configuration
# Copy this file to .env and customize for your environment
#
# NOTE: .env.yaml is the recommended configuration format.
#       .env (KEY=VALUE) is provided for legacy compatibility only.
#       See .env.yaml for the full YAML-based configuration with variable substitution.

# ─────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orm_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_DRIVER=pdo_sqlite
DB_PATH=var/data/orm.db

# ─────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────
APP_ENV=dev
APP_SECRET=change-me-in-production

# ─────────────────────────────────────────────
# ORM / Doctrine Settings
ORM_PROXY_DIR=/tmp/orm/proxies
ORM_PROXY_NAMESPACE=Oryx\ORM\Proxy

# ─────────────────────────────────────────────
# Cache Configuration (auto-enabled in prod)
# Set CACHE_ENABLED=true to force enable in dev
# ─────────────────────────────────────────────
CACHE_DRIVER=array
CACHE_HOST=localhost
CACHE_PORT=11211
CACHE_TTL=3600
CACHE_ENABLED=false
# REDIS_HOST and REDIS_PORT removed: persistent cache should be provided via PSR adapters if needed

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW=60
# MEMCACHED_HOST and MEMCACHED_PORT deprecated (rate limiter will use local fallback if not configured)

# ─────────────────────────────────────────────
# Mailer Settings
# ─────────────────────────────────────────────
MAILER_TRANSPORT=smtp
MAILER_HOST=localhost
MAILER_PORT=25
MAILER_USER=
MAILER_PASSWORD=
