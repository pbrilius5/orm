# Oryx ORM Environment Configuration
# Copy this file to .env and customize for your environment
#
# NOTE: .env.yaml is the recommended configuration format.
#       .env (KEY=VALUE) is provided for legacy compatibility only.
#       See .env.yaml for the full YAML-based configuration with variable substitution.

# ─────────────────────────────────────────────
# Database Configuration
# ─────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orm_db
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_DRIVER=pdo_sqlite
DB_PATH=var/data/orm.db

# ─────────────────────────────────────────────
# Application Settings
# ─────────────────────────────────────────────
APP_ENV=dev
APP_DEBUG=true
APP_SECRET=change-me-in-production

# ─────────────────────────────────────────────
# ORM / Doctrine Settings
# ORM_AUTO_GENERATE_PROXY=true   # Set to override app-mode default (true=eval, false=never)
# ORM_AUTO_GENERATE_PROXY=false  # Use for production (pre-generate proxies first)
ORM_PROXY_DIR=/tmp/orm/proxies
ORM_PROXY_NAMESPACE=Oryx\ORM\Proxy

# ─────────────────────────────────────────────
# Cache Configuration
# ─────────────────────────────────────────────
CACHE_DRIVER=array
CACHE_HOST=localhost
CACHE_PORT=11211
CACHE_TTL=3600

# ─────────────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW=60
MEMCACHED_HOST=localhost
MEMCACHED_PORT=11211

# ─────────────────────────────────────────────
# Mailer Settings
# ─────────────────────────────────────────────
MAILER_TRANSPORT=smtp
MAILER_HOST=localhost
MAILER_PORT=25
MAILER_USER=
MAILER_PASSWORD=
