# Database Configuration
# Copy this file to .env and customize for your environment

DB_HOST=localhost
DB_PORT=3306
DB_NAME=orm_db
DB_USER=root
DB_PASSWORD=

# Application Settings
APP_ENV=dev
APP_DEBUG=true

# ORM Settings
ORM_AUTO_GENERATE_PROXY=false
ORM_PROXY_DIR=/tmp/orm/proxies
ORM_PROXY_NAMESPACE=Oryx\ORM\Proxy